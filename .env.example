# ==============================================================================
# SHOPLAGBE E-COMMERCE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME="ShopLagbe E-Commerce"
APP_ENV=local
APP_KEY=base64:u1sL+3d9O6VjYnS9k1yL/K8eM4xN6pQ8vR0tW2yZ4xA=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shoplagbe_db
DB_USERNAME=shoplagbe_user
DB_PASSWORD=shoplagbe_secure_password

# Cache & Session & Queue (Redis)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ==============================================================================
# PAYMENT GATEWAYS (SANDBOX)
# ==============================================================================

# bKash Sandbox (API v2.0 / Sandbox Endpoint)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0
BKASH_APP_KEY=sandbox_bkash_app_key_demo
BKASH_APP_SECRET=sandbox_bkash_secret_demo_345678
BKASH_USERNAME=sandbox_bkash_user
BKASH_PASSWORD=sandbox_bkash_password
BKASH_CALLBACK_URL=http://localhost:8000/api/payment/bkash/callback

# SSLCommerz Sandbox
SSLC_STORE_ID=testbox
SSLC_STORE_PASSWORD=qwerty
SSLC_SANDBOX=true
SSLC_BASE_URL=https://sandbox.sslcommerz.com
SSLC_SUCCESS_URL=http://localhost:8000/api/payment/sslcommerz/success
SSLC_FAIL_URL=http://localhost:8000/api/payment/sslcommerz/fail
SSLC_CANCEL_URL=http://localhost:8000/api/payment/sslcommerz/cancel
SSLC_IPN_URL=http://localhost:8000/api/payment/sslcommerz/ipn

# ==============================================================================
# COURIER INTEGRATION (CARRYBEE)
# ==============================================================================
CARRYBEE_BASE_URL=https://api.carrybee.com/v1
CARRYBEE_CLIENT_ID=carrybee_sandbox_client_id
CARRYBEE_CLIENT_SECRET=carrybee_sandbox_client_secret
CARRYBEE_CLIENT_CONTEXT=ecommerce_sandbox

# Delivery Defaults
DEFAULT_SHIPPING_COST=60
INSIDE_DHAKA_SHIPPING=60
OUTSIDE_DHAKA_SHIPPING=120
